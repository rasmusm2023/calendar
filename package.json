{
  "name": "spaces-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && npm --prefix functions run typecheck",
    "build:functions": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test",
    "test:functions:emulator": "npm run build:functions && firebase emulators:exec --only auth,firestore,functions --project demo-spaces-calendar-fn \"npm --prefix functions run test:emulator\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-spaces-calendar-rules \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-spaces-calendar",
    "emulators:e2e": "npm run build:functions && firebase emulators:start --only auth,firestore,functions --project demo-spaces-calendar",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "i18next": "^26.4.5",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
