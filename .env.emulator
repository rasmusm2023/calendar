# Konfiguration för lokal utveckling och E2E mot Firebase Emulator Suite (npm run dev:emulator).
# Innehåller bara påhittade demo-värden för ett "demo-"-projekt och inga riktiga nycklar, så den
# får committas. Riktiga värden ligger i .env.local (som inte committas).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-spaces-calendar
VITE_FIREBASE_APP_ID=demo-app-id
VITE_GOOGLE_CLIENT_ID=demo-google-client-id.apps.googleusercontent.com
VITE_FIREBASE_FUNCTIONS_REGION=europe-west3
VITE_USE_EMULATORS=true
