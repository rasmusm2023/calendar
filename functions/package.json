    "test:emulator": "vitest run --config vitest.emulator.config.mts"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
