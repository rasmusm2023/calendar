{
  "name": "spaces-calendar-functions",
  "private": true,
  "version": "0.0.0",
  "description": "Cloud Functions för Spaces Calendar: byter OAuth-kod mot tokens och delar ut access tokens.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
