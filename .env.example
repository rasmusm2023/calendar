# Kopiera till .env.local och fyll i riktiga värden (se PROJECT.md §8). .env.local committas aldrig.
#
# Alla VITE_-variabler är PUBLIKA och hamnar i webbläsaren. Lägg ALDRIG hemligheter här.
# GOOGLE_CLIENT_SECRET ligger som secret i Cloud Functions (firebase functions:secrets:set).

# Firebase-konsolen -> Project settings -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=REPLACE_ME

# Region för Cloud Functions. Ska matcha functions/ (Frankfurt, nära södra Sverige).
VITE_FIREBASE_FUNCTIONS_REGION=europe-west3

# "true" pekar Auth, Firestore och Functions mot lokala emulatorer (npm run emulators).
# För vanlig utveckling mot emulatorer finns färdig konfiguration: npm run dev:emulator
VITE_USE_EMULATORS=false
